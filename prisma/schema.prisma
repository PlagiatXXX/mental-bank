generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Анонимный пользователь
model User {
  id         String   @id @default(cuid())
  nickname   String   // отображаемое имя
  avatar     String   @default("🪙") // emoji-аватар
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  victories          Victory[]
  espEntries         ESPEntry[]
  affirmations       Affirmation[]
  visualizations     Visualization[]
  confidenceAttacks  ConfidenceAttack[]
  rituals            Ritual[]
  aars               AAR[]

  @@map("users")
}

/// Запись о победе пользователя (Топ-10) — Глава 2, Счёт №1
model Victory {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  position    Int      // 1–10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("victories")
  @@index([userId])
}

/// Ежедневная запись E-S-P дневника — Глава 2, Счёт №1
model ESPEntry {
  id        String   @id @default(cuid())
  date      DateTime // одна запись на день на пользователя
  effort    String   // E — Effort
  success   String   // S — Success
  progress  String   // P — Progress
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("esp_entries")
  @@unique([userId, date])
  @@index([userId])
}

/// Аффирмация — Глава 3, Счёт №2 (Настоящее)
model Affirmation {
  id        String   @id @default(cuid())
  text      String   // текст аффирмации
  context   String?  // для какой ситуации (работа, спорт, отношения)
  isValid   Boolean  @default(true) // проходит ли 5 правил книги
  hitCount  Int      @default(0)  // сколько раз повторили
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("affirmations")
  @@index([userId])
}

/// Сценарий визуализации — Глава 4, Счёт №3 (Будущее)
model Visualization {
  id        String   @id @default(cuid())
  title     String
  content   String   // полный скрипт
  eventDate DateTime? // дата события, к которому готовимся
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("visualizations")
  @@index([userId])
}

/// Атака на уверенность — Глава 5 (Защита)
model ConfidenceAttack {
  id        String   @id @default(cuid())
  source    String   // кто/что атаковало
  type      String   // "internal" | "external"
  context   String   // описание ситуации
  defence   String?  // какие шаги предпринял (4 шага защиты)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("confidence_attacks")
  @@index([userId])
}

/// Ритуал — Глава 7 (Вход на арену)
model Ritual {
  id        String   @id @default(cuid())
  name      String
  steps     String   // JSON-массив шагов
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("rituals")
  @@index([userId])
}

/// AAR — After Action Review, Глава 9
model AAR {
  id           String   @id @default(cuid())
  eventTitle   String   // название события
  whatHappened String?  // Шаг 1: что произошло
  soWhat       String?  // Шаг 2: что это значит
  nowWhat      String?  // Шаг 3: что теперь делать
  balanceType  String   @default("loss") // "win" | "loss" — влияет на 80/20 или 60/40
  lessons      String?  // извлечённые уроки (JSON array)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("aars")
  @@index([userId])
}
